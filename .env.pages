# Loaded only by `npm run build:pages` (vite build --mode pages) for the GitHub Pages demo.
# Turns on the demo-products fallback when the backend cannot be reached.
# Never set this for the real site build.
VITE_DEMO_FALLBACK=true

# Live backend on Render (free plan, first request after idle can take ~50 s;
# while it wakes up the demo fallback above answers instead).
VITE_API_BASE_URL=https://curtain-shop-api.onrender.com/api
VITE_BACKEND_ORIGIN=https://curtain-shop-api.onrender.com
