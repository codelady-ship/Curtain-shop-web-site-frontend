# Copy to .env.production.local (git-ignored) or set these in your CI before `npm run build`.

# Backend API. The app appends /api if it is missing.
# Dev default: /api (proxied to http://127.0.0.1:8080 by vite.config.js).
# Production (Render): https://curtain-shop-api.onrender.com
VITE_API_BASE_URL=https://curtain-shop-api.onrender.com

# Origin used to build absolute URLs for uploaded images (/uploads/...).
VITE_BACKEND_ORIGIN=https://curtain-shop-api.onrender.com

# Demo-products fallback. Only the GitHub Pages demo sets this (see .env.pages).
# Leave unset for the real site.
# VITE_DEMO_FALLBACK=true
